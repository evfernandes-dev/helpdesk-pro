# Local development values for Docker Compose.
# Copy this file to .env and change the passwords before running.

DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# The host is "mysql" because it is the service name in docker-compose.yml.
# For a local run without Docker, use localhost in SPRING_DATASOURCE_URL.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/helpdesk_pro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
